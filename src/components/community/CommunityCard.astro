---
import type { AnalyticsEvent, CommunityDestination } from '../../types';
import { analyticsAttrs } from '../../lib/analytics';

interface Props {
  destination: CommunityDestination;
}

const { destination } = Astro.props;

const typeLabel: Record<CommunityDestination['type'], string> = {
  broadcast: 'Canal de WhatsApp',
  group: 'Grupo de WhatsApp',
};

const actionLabel: Record<CommunityDestination['audienceAction'], string> = {
  follow: 'Seguir canal',
  join: 'Unirme al grupo',
};

const analyticsEvent: AnalyticsEvent =
  destination.type === 'broadcast' ? 'whatsapp_channel_click' : 'whatsapp_group_click';
---

<article class="community-card">
  <p class="community-card__type">{typeLabel[destination.type]}</p>
  <h3 class="community-card__name">{destination.name}</h3>
  <p class="community-card__description">{destination.description}</p>

  {
    destination.active ? (
      <a
        href={destination.url}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary community-card__action"
        {...analyticsAttrs(analyticsEvent, { id: destination.id })}
      >
        {actionLabel[destination.audienceAction]}
      </a>
    ) : (
      <p class="empty-state">Enlace de invitación disponible próximamente.</p>
    )
  }
</article>

<style>
  .community-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .community-card__type {
    font-family: var(--font-heading);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-tech-purple);
  }

  .community-card__name {
    font-size: var(--fs-lg);
  }

  .community-card__action {
    margin-top: var(--space-4);
    align-self: flex-start;
  }
</style>
