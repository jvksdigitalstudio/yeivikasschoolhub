---
import type { Resource } from '../../types';
import { analyticsAttrs } from '../../lib/analytics';

interface Props {
  resource: Resource;
}

const { resource } = Astro.props;

const availabilityLabel: Record<Resource['availability'], string> = {
  free: 'Gratis',
  premium: 'Premium',
  external: 'Enlace externo',
  'coming-soon': 'Próximamente',
};
---

<article class="resource-card">
  <div class="resource-card__thumb">
    {
      resource.image ? (
        <img src={resource.image} alt={resource.title} loading="lazy" />
      ) : (
        <span class="resource-card__thumb-fallback" aria-hidden="true">
          {resource.type}
        </span>
      )
    }
  </div>

  <div class="resource-card__body">
    <p class="resource-card__category">{resource.category}</p>
    <h3 class="resource-card__title">{resource.title}</h3>
    <p class="resource-card__description">{resource.description}</p>

    <div class="resource-card__footer">
      <span class={`resource-card__badge resource-card__badge--${resource.availability}`}>
        {availabilityLabel[resource.availability]}
      </span>

      {
        resource.availability !== 'coming-soon' && (
          <a
            href={resource.url}
            target={resource.external ? '_blank' : undefined}
            rel={resource.external ? 'noopener noreferrer' : undefined}
            {...analyticsAttrs('resource_click', { id: resource.id, type: resource.type })}
          >
            Ver recurso
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .resource-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .resource-card__thumb {
    aspect-ratio: 4 / 3;
    background: var(--color-surface-elevated);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .resource-card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .resource-card__thumb-fallback {
    font-family: var(--font-heading);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .resource-card__body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .resource-card__category {
    font-family: var(--font-heading);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-tech-purple);
  }

  .resource-card__title {
    font-size: var(--fs-md);
    color: var(--color-text);
  }

  .resource-card__footer {
    margin-top: auto;
    padding-top: var(--space-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .resource-card__badge {
    font-family: var(--font-heading);
    font-size: var(--fs-xs);
    font-weight: 700;
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .resource-card__badge--free {
    color: #7bd88f;
    border-color: color-mix(in srgb, #7bd88f 40%, var(--color-border));
  }

  .resource-card__badge--premium {
    color: var(--color-brand-gold);
    border-color: color-mix(in srgb, var(--color-brand-gold) 40%, var(--color-border));
  }

  .resource-card__footer a {
    font-family: var(--font-heading);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
