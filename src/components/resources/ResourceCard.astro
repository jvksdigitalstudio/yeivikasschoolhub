---
import type { Resource, ResourceAvailability, ResourceType } from '../../types';
import { analyticsAttrs } from '../../lib/analytics';

interface Props {
  resource: Resource;
}

const { resource } = Astro.props;

// Estado comercial (eje independiente de dónde vive el enlace: ver
// `source` más abajo y la nota de diseño en `content.config.ts`).
const availabilityLabel: Record<ResourceAvailability, string> = {
  free: 'Gratis',
  premium: 'Premium',
  'coming-soon': 'Próximamente',
};

// Procedencia del enlace. Solo se muestra un indicador adicional
// cuando el recurso vive fuera del Hub: para `internal` no hace
// falta anunciar nada (es el caso implícito/por defecto).
const sourceLabel = resource.data.source === 'external' ? 'Enlace externo' : undefined;

// Etiqueta de presentación en español. El valor interno del schema
// (resource.data.type) se sigue usando tal cual para analytics: solo
// la UI necesita una traducción, el modelo no cambia.
const typeLabel: Record<ResourceType, string> = {
  dwp: 'DWP',
  instrument: 'Instrumento',
  preset: 'Preset',
  sample: 'Sample',
  tool: 'Herramienta',
  other: 'Otro',
};
---

<article class="resource-card">
  <div class="resource-card__thumb">
    {
      resource.data.image ? (
        <img src={resource.data.image} alt={resource.data.title} loading="lazy" />
      ) : (
        <span class="resource-card__thumb-fallback" aria-hidden="true">
          {typeLabel[resource.data.type]}
        </span>
      )
    }
  </div>

  <div class="resource-card__body">
    <p class="resource-card__category">{resource.data.category}</p>
    <h3 class="resource-card__title">{resource.data.title}</h3>
    <p class="resource-card__description">{resource.data.description}</p>

    <div class="resource-card__footer">
      <div class="resource-card__badges">
        <span class={`resource-card__badge resource-card__badge--${resource.data.availability}`}>
          {availabilityLabel[resource.data.availability]}
        </span>
        {sourceLabel && <span class="resource-card__badge resource-card__badge--source">{sourceLabel}</span>}
      </div>

      {
        resource.data.url && resource.data.availability !== 'coming-soon' && (
          <a
            href={resource.data.url}
            target="_blank"
            rel="noopener noreferrer"
            {...analyticsAttrs('resource_click', { id: resource.id, type: resource.data.type })}
          >
            Ver recurso
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .resource-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .resource-card__thumb {
    aspect-ratio: 4 / 3;
    background: var(--color-surface-elevated);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .resource-card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .resource-card__thumb-fallback {
    font-family: var(--font-heading);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .resource-card__body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .resource-card__category {
    font-family: var(--font-heading);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-tech-purple);
  }

  .resource-card__title {
    font-size: var(--fs-md);
    color: var(--color-text);
  }

  .resource-card__footer {
    margin-top: auto;
    padding-top: var(--space-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .resource-card__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .resource-card__badge {
    font-family: var(--font-heading);
    font-size: var(--fs-xs);
    font-weight: 700;
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .resource-card__badge--free {
    color: var(--color-success);
    border-color: color-mix(in srgb, var(--color-success) 40%, var(--color-border));
  }

  .resource-card__badge--premium {
    color: var(--color-brand-gold);
    border-color: color-mix(in srgb, var(--color-brand-gold) 40%, var(--color-border));
  }

  .resource-card__footer a {
    font-family: var(--font-heading);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
