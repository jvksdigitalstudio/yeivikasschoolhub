---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import ResourceGrid from '../../components/resources/ResourceGrid.astro';
import { resources } from '../../data/resources';

const pageDescription =
  'DAW, instrumentos, presets, samples y herramientas para producción musical.';
---

<BaseLayout title="Recursos" description={pageDescription} path="/recursos">
  <PageHeader eyebrow="Recursos" title="Recursos" description={pageDescription} />

  <section class="section">
    <div class="container">
      <ResourceGrid resources={resources} />
    </div>
  </section>
</BaseLayout>
